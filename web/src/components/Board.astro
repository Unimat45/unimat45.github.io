---
import { ArrowRight, ArrowUpRight } from "lucide-react";

import { initI18n, type Locale } from "../lib/i18n";
import Pport from "./Pport.astro";

interface Props {
    locale: Locale;
    /** Show the "got a project in mind?" call to action (hidden on the contact page itself). */
    cta?: boolean;
    /** Draw the copper trace arriving from the project stack above (homepage). */
    trace?: boolean;
}

const { locale, cta = true, trace = false } = Astro.props;
const { t } = initI18n({ locale });
---

<footer class="board">
    <div class="wrap board-grid">
        {
            cta && (
                <div class="cta">
                    <p class="eyebrow">
                        {trace && (
                            <span class="seg" aria-hidden="true">
                                <i />
                            </span>
                        )}
                        <span class="via" aria-hidden="true" />
                        <span>{t(($) => $.global.boardEyebrow)}</span>
                    </p>
                    <h2>{t(($) => $.global.boardTitle)}</h2>
                    <p class="pitch">{t(($) => $.global.boardText)}</p>
                    <div class="actions">
                        <a class="btn" href={`/${locale}/contact`}>
                            <span>{t(($) => $.global.boardCta)}</span>
                            <ArrowRight aria-hidden="true" />
                        </a>
                        <a
                            class="text-link"
                            href="https://github.com/unimat45"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <span>GitHub</span>
                            <ArrowUpRight aria-hidden="true" />
                        </a>
                    </div>
                </div>
            )
        }

        <div class="panel">
            <Pport locale={locale} />
        </div>

        <div class="legal">
            <span>&copy; {new Date().getFullYear()} Mathieu Dery</span>
            <nav aria-label={t(($) => $.global.footerLabel)}>
                <a href={`/${locale}/`}>{t(($) => $.global.navHome)}</a>
                <a href={`/${locale}/projects`}>{t(($) => $.global.navProjects)}</a>
                <a href={`/${locale}/contact`}>{t(($) => $.global.navContact)}</a>
                <a href="https://github.com/unimat45" target="_blank" rel="noopener noreferrer">GitHub</a>
            </nav>
        </div>
    </div>
</footer>

<style>
    .board {
        --pt: clamp(3.5rem, 8vw, 6rem);
        padding-block: var(--pt) clamp(2rem, 5vw, 3.5rem);
        background: var(--board);
        color: var(--board-ink);
    }

    .board-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 29rem);
        grid-template-areas:
            "cta panel"
            "legal panel";
        grid-template-rows: auto 1fr;
        gap: 2.5rem clamp(2.5rem, 6vw, 6rem);
        align-items: start;
    }

    .cta {
        grid-area: cta;
    }

    .panel {
        grid-area: panel;
    }

    .eyebrow {
        position: relative;
        display: inline-block;
        padding-left: 1.75rem;
        color: var(--board-ink-2);
    }

    /* The trace's last run comes down from the stack into this via. */
    .seg {
        top: auto;
        bottom: 50%;
        height: calc(var(--pt) + 50%);
        background: var(--board-line);
    }

    .seg i {
        background: var(--board-copper);
    }

    .via {
        top: 50%;
        margin-top: -7px;
        background: var(--board-copper);
        box-shadow:
            0 0 0 4px var(--board),
            0 0 18px 2px rgb(240 145 90 / 0.55);
    }

    :global(.js) .via:not(.on) {
        background: var(--board);
        box-shadow:
            0 0 0 4px var(--board),
            inset 0 0 0 2px rgb(233 239 230 / 0.3);
    }

    h2 {
        margin-top: 1.1rem;
        font-size: clamp(2.6rem, 6.4vw, 5rem);
        font-weight: 800;
        font-stretch: 88%;
        line-height: 0.98;
        letter-spacing: -0.022em;
    }

    .pitch {
        margin-top: 1.25rem;
        max-width: 30rem;
        font-size: 1.1rem;
        color: var(--board-ink-2);
    }

    .btn {
        background: var(--board-copper);
        color: #1c0f07;
    }

    .btn:hover {
        background: #ffb184;
    }

    .text-link {
        text-decoration-color: rgb(233 239 230 / 0.3);
    }

    .text-link:hover {
        text-decoration-color: var(--board-copper);
    }

    .board :focus-visible {
        outline-color: var(--board-copper);
    }

    .legal {
        grid-area: legal;
        align-self: end;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.75rem 2rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--board-line);
        font-family: var(--mono);
        font-size: 0.75rem;
        color: var(--board-ink-2);
    }

    .legal nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
    }

    .legal a {
        text-decoration: none;
        transition: color 0.25s;
    }

    .legal a:hover {
        color: var(--board-ink);
    }

    @media (max-width: 56rem) {
        .board-grid {
            grid-template-columns: minmax(0, 1fr);
            grid-template-areas:
                "cta"
                "panel"
                "legal";
            grid-template-rows: auto;
        }

        .panel {
            max-width: 31rem;
        }
    }
</style>
