---
import { Seo } from "astro-seo-meta";

import Board from "../components/Board.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { initI18n, toLocale, type Pages } from "../lib/i18n/index";
import "../lib/strings";
import { cn } from "../lib/utils";
import "../styles/global.css";

interface Props {
    className?: string;
    page: Pages;
    title?: string;
    description?: string;
    image?: string;
    /** Show the footer's call to action (off on the contact page). */
    boardCta?: boolean;
    /** Draw the trace into the footer (homepage, where the project stack sits above it). */
    boardTrace?: boolean;
}

const locale = toLocale(Astro.params.locale);
const { className, page, title, description, image, boardCta = true, boardTrace = false } = Astro.props;

const { t } = initI18n({ locale });
---

<!doctype html>
<html lang={locale} data-theme="light">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
        <meta name="color-scheme" content="light dark" />
        <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
        <link rel="manifest" type="application/json" href="/manifest.json" />
        <link rel="preload" href="/fonts/bricolage-grotesque.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/ibm-plex-mono-500.woff2" as="font" type="font/woff2" crossorigin />
        <meta name="generator" content={Astro.generator} />

        <script is:inline>
            /* eslint-disable prettier/prettier -- the rule parses inline scripts as Astro markup and rejects any {} block */
            // Settle the theme before first paint: the visitor's last choice, else their system setting.
            {
                const root = document.documentElement;
                let theme = null;
                try {
                    theme = localStorage.getItem("md-lights");
                }
                catch {
                    theme = null;
                }
                if (theme !== "light" && theme !== "dark") {
                    theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                }
                root.dataset.theme = theme;
                root.classList.add("js");
            }
        </script>

        <Seo
            title={t(($) => $.global.title, { title: title || t(($) => $[page].title) })}
            description={description || t(($) => $[page].description)}
            facebook={{
                image: new URL(image || t(($) => $.global.image), "https://unimat45.github.io/").toString(),
                url: "https://unimat45.github.io/",
                type: "website",
            }}
            twitter={{
                image: new URL(image || t(($) => $.global.image), "https://unimat45.github.io/").toString(),
                site: "https://unimat45.github.io/",
                card: "summary",
            }}
        />
    </head>
    <body class="flex min-h-screen flex-col">
        <a class="skip" href="#content">{t(($) => $.global.skip)}</a>
        <SiteHeader locale={locale} page={page} />

        <main id="content" class={cn("flex-1", className)}>
            <slot />
        </main>

        <Board locale={locale} cta={boardCta} trace={boardTrace} />

        <script>
            import "../scripts/site.ts";
        </script>
    </body>
</html>
