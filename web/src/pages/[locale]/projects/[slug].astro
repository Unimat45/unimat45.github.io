---
import type { GetStaticPaths } from "astro";
import { ArrowLeft, ArrowUpRight } from "lucide-react";

import { mediaFor } from "../../../assets/media";
import { layers, projects } from "../../../assets/projects";
import ProjectGallery from "../../../components/ProjectGallery.astro";
import Layout from "../../../layouts/Layout.astro";
import { initI18n, toLocale } from "../../../lib/i18n";

export const getStaticPaths = (() => {
    return [
        ...projects.map((p) => ({
            params: { locale: "fr", slug: p.slug },
        })),
        ...projects.map((p) => ({
            params: { locale: "en", slug: p.slug },
        })),
    ];
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const locale = toLocale(Astro.params.locale);
const { t } = initI18n({ locale });

const project = projects.find((p) => p.slug === slug);

if (!project) {
    throw new Error(`Slug not found: ${slug}`);
}

const description = locale === "fr" ? project.description_fr : project.description_en;
const depth = project.depth === 0 ? "0" : `−${Math.abs(project.depth)}`;
const card = "rounded-2xl border border-line bg-surface p-6 md:p-8";
const linkCard =
    "group flex items-center justify-between gap-3 rounded-xl border border-line px-4 py-3 font-semibold transition-colors hover:border-accent-strong hover:text-accent";
---

<Layout
    page="projects"
    title={project.title}
    description={description}
    image={`/images/projets/${slug}/logo.webp`}
    className="wrap pt-[clamp(2rem,5vw,4rem)] pb-(--section)"
>
    <a href={`/${locale}/projects`} class="text-link mb-8">
        <ArrowLeft aria-hidden="true" />
        <span>{t(($) => $.projects.back)}</span>
    </a>

    <header class="mt-8" data-reveal>
        <p class="eyebrow">{depth} · {layers[project.layer][locale]}</p>
        <h1 class="display mt-4 text-[clamp(2.6rem,7vw,5rem)]">{project.title}</h1>
        <p class="mt-5 max-w-2xl text-lg text-ink-2">
            {locale === "fr" ? project.summary_fr : project.summary_en}
        </p>
    </header>

    <div class="mt-10">
        <ProjectGallery shots={mediaFor(project.slug).shots} locale={locale} />
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <section class={card}>
            <h2 class="text-2xl font-bold [font-stretch:90%]">{t(($) => $.projects.overview)}</h2>
            <p class="mt-4 text-lg leading-relaxed text-ink-2">{description}</p>
        </section>

        <div class="grid content-start gap-6">
            <section class={card}>
                <h2 class="eyebrow">{t(($) => $.projects.tech)}</h2>
                <ul class="mt-4 flex flex-wrap gap-2">
                    {
                        project.tags.map((tag) => (
                            <li class="rounded-full border border-line px-3 py-1 font-mono text-xs text-ink-2">
                                {tag}
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section class={card}>
                <h2 class="eyebrow">
                    {t(($) => $.projects.link, { count: project.has_code && project.has_demo ? 2 : 1 })}
                </h2>
                <div class="mt-4 grid gap-3">
                    {
                        project.has_demo && (
                            <a href={project.link_demo} target="_blank" rel="noopener noreferrer" class={linkCard}>
                                <span>{t(($) => $.projects.link_demo)}</span>
                                <ArrowUpRight
                                    size={18}
                                    className="text-accent-strong transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                                    aria-hidden="true"
                                />
                            </a>
                        )
                    }
                    {
                        project.has_code && (
                            <a href={project.link_code} target="_blank" rel="noopener noreferrer" class={linkCard}>
                                <span>{t(($) => $.projects.link_code)}</span>
                                <ArrowUpRight
                                    size={18}
                                    className="text-accent-strong transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                                    aria-hidden="true"
                                />
                            </a>
                        )
                    }
                </div>
            </section>
        </div>
    </div>
</Layout>
