---
import type { GetStaticPaths } from "astro";

import PageHead from "../../../components/PageHead.astro";
import { Projects } from "../../../components/Projects";
import Layout from "../../../layouts/Layout.astro";
import { initI18n, toLocale } from "../../../lib/i18n";

export const getStaticPaths = (() => {
    return [{ params: { locale: "fr" } }, { params: { locale: "en" } }];
}) satisfies GetStaticPaths;

const locale = toLocale(Astro.params.locale);
const { t } = initI18n({ locale });

const labels = {
    all: t(($) => $.projects.filterAll),
    demo: t(($) => $.global.demo),
    code: t(($) => $.global.code),
};
---

<Layout page="projects" className="wrap pt-[clamp(2.5rem,6vw,5rem)] pb-(--section)">
    <PageHead
        eyebrow={t(($) => $.global.navProjects)}
        title={t(($) => $.projects.title)}
        description={t(($) => $.projects.description)}
    />

    <Projects locale={locale} labels={labels} client:load />
</Layout>
