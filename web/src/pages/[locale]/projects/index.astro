---
import type { GetStaticPaths } from "astro";
import { getImage } from "astro:assets";

import { thumbFor } from "../../../assets/media";
import { projects } from "../../../assets/projects";
import type { Thumb } from "../../../components/ProjectCard";
import PageHead from "../../../components/PageHead.astro";
import { Projects } from "../../../components/Projects";
import Layout from "../../../layouts/Layout.astro";
import { initI18n, toLocale } from "../../../lib/i18n";

export const getStaticPaths = (() => {
    return [{ params: { locale: "fr" } }, { params: { locale: "en" } }];
}) satisfies GetStaticPaths;

const locale = toLocale(Astro.params.locale);
const { t } = initI18n({ locale });

const labels = {
    all: t(($) => $.projects.filterAll),
    demo: t(($) => $.global.demo),
    code: t(($) => $.global.code),
};

/* The cards are a React island: resize their thumbnails here and hand over the ready-made sources. */
const thumbs: Record<string, Thumb> = Object.fromEntries(
    await Promise.all(
        projects.map(async (p) => {
            const { image, focus } = thumbFor(p.slug);
            const img = await getImage({ src: image, widths: [400, 720, 1080].filter((w) => w <= image.width) });
            return [p.slug, { src: img.src, srcset: img.srcSet.attribute, focus }];
        }),
    ),
);
---

<Layout page="projects" className="wrap pt-[clamp(2.5rem,6vw,5rem)] pb-(--section)">
    <PageHead
        eyebrow={t(($) => $.global.navProjects)}
        title={t(($) => $.projects.title)}
        description={t(($) => $.projects.description)}
    />

    <Projects locale={locale} labels={labels} thumbs={thumbs} client:load />
</Layout>
