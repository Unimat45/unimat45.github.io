---
import { ArrowLeft } from "lucide-react";

import FancyLastWord from "../components/FancyLastWord.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout page="index" className="wrap grid content-center py-(--section)">
    <p class="eyebrow">Erreur 404</p>
    <h1 class="display mt-4 text-[clamp(2.6rem,8vw,6rem)]">
        Page non
        <FancyLastWord>trouvée</FancyLastWord>
    </h1>
    <p class="mt-5 max-w-xl text-lg text-ink-2">Cette page n'existe pas, ou plus.</p>
    <div class="actions">
        <a href="/fr/" class="btn">
            <ArrowLeft aria-hidden="true" />
            <span>Retour à l'accueil</span>
        </a>
    </div>
</Layout>
